<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentTop="true"
    android:fitsSystemWindows="true"
    tools:context="com.dnrcpw.cpwmobilepdf.activities.MainActivity">

  <!-- wait icon -->
  <!--RelativeLayout
      android:id="@+id/loadingPanel"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center" -->
  <com.github.barteksc.pdfviewer.PDFView
      android:id="@+id/pdfView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_alignParentTop="false"></com.github.barteksc.pdfviewer.PDFView>

  <ProgressBar
      android:id="@+id/loadingPanel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:gravity="center"
      android:indeterminate="true" />
  <!--/RelativeLayout-->

  <!-- Must have width and height set to wrap_content, or it will not show up on top -->
  <!-- Current Position -->
  <TextView
      android:id="@+id/cur_pos"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentTop="false"
      android:background="@color/black_overlay"
      android:fitsSystemWindows="false"
      android:paddingStart="10dp"
      android:paddingTop="5dp"
      android:paddingEnd="10dp"
      android:paddingBottom="5dp"
      android:text="@string/CurPos"
      android:textColor="@color/white"
      android:textStyle="bold" />
  <!-- Move Waypoint Instructions -->
  <TextView
      android:id="@+id/move_instr"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentTop="false"
      android:background="#FFEB3B"
      android:fitsSystemWindows="false"
      android:paddingStart="10dp"
      android:paddingTop="5dp"
      android:paddingEnd="10dp"
      android:paddingBottom="5dp"
      android:text="@string/move_instructions"
      android:textColor="#33691E"
      android:visibility="gone" />

  <!-- Load adjacent maps menu button -->
  <Button
      android:id="@+id/load_adjacent_maps"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_below="@+id/cur_pos"
      android:layout_alignParentTop="false"
      android:background="#BF9E9C9C"
      android:fitsSystemWindows="false"
      android:text="@string/load_adjacent_maps"
      android:textColor="#212121"
      android:visibility="gone" />
  <!-- debug text view -->
  <TextView
      android:id="@+id/distance_text_view"
      android:layout_width="300dp"
      android:layout_height="20dp"
      android:layout_alignParentBottom="true"
      android:layout_alignParentEnd="true"
      android:text="Distance traveled"
      android:textColor="#212121"/>

</RelativeLayout>